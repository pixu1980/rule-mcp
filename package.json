{
  "name": "rule-mcp-workspace",
  "version": "0.1.2",
  "description": "RuleMCP - MCP server for the rule-mcp-* skill ecosystem. Serves styleguides, component templates, framework best practices, and design system patterns.",
  "type": "module",
  "license": "MIT",
  "author": "pixu1980",
  "homepage": "https://github.com/pixu1980/rule-mcp",
  "repository": "github:pixu1980/rule-mcp",
  "bugs": {
    "url": "https://github.com/pixu1980/rule-mcp/issues"
  },
  "private": true,
  "bin": {
    "rule-mcp": "./bin/rule-mcp.js"
  },
  "scripts": {
    "dev": "node ./bin/rule-mcp.js serve",
    "docs:dev": "pnpm --filter rule-mcp-docs dev",
    "docs:build": "pnpm --filter rule-mcp-docs build",
    "dev:sse": "node ./bin/rule-mcp.js serve --transport sse",
    "dev:daemon": "node ./bin/rule-mcp.js daemon start",
    "inspector": "node ./node_modules/@modelcontextprotocol/inspector/cli/build/cli.js node ./bin/rule-mcp.js serve",
    "doctor": "node ./bin/rule-mcp.js doctor",
    "prepare": "node scripts/install/git-hooks/index.mjs",
    "hooks:install": "node scripts/install/git-hooks/index.mjs",
    "hooks:check": "node scripts/install/git-hooks/index.mjs --check",
    "setup": "bash ./scripts/reinstall.sh && node ./bin/rule-mcp.js setup",
    "setup:uninstall": "node ./bin/rule-mcp.js setup --uninstall",
    "uninstall": "node ./bin/rule-mcp.js uninstall",
    "tools": "node ./bin/rule-mcp.js tools list",
    "mcp:install": "bash ./scripts/install.sh --force",
    "mcp:install:ps1": "pwsh ./scripts/install.ps1",
    "mcp:uninstall": "bash ./scripts/uninstall.sh --force",
    "post-process": "node --import ./scripts/alias-hook.mjs scripts/fix/post-process/index.mjs",
    "post-process:fix": "node --import ./scripts/alias-hook.mjs scripts/fix/post-process/index.mjs --fix --no-dry-run",
    "mcp:uninstall:ps1": "pwsh ./scripts/uninstall.ps1",
    "skills:install": "echo \"ℹ️ pnpm skills:install: skills are loaded directly from ./skills - no separate install step is needed.\"",
    "test": "node --import ./scripts/alias-hook.mjs ./scripts/__tests__/smoke.mjs",
    "test:coverage": "node --import ./scripts/alias-hook.mjs scripts/reports/coverage/index.mjs",
    "test:foundations": "node --import ./scripts/alias-hook.mjs scripts/ci/run-tests/index.mjs foundations",
    "test:installer": "node --import ./scripts/alias-hook.mjs scripts/ci/run-tests/index.mjs installer",
    "test:all": "node --import ./scripts/alias-hook.mjs scripts/ci/run-tests/index.mjs all",
    "test:e2e:docs-site": "playwright test scripts/__tests__/e2e/docs-site",
    "lint": "eslint bin/ packages/ scripts/__tests__/ --max-warnings 50",
    "lint:fix": "eslint bin/ packages/ scripts/__tests__/ --max-warnings 50 --fix",
    "format": "prettier --check '**/*.{js,mjs,json,md}' --ignore-path .gitignore",
    "format:fix": "prettier --write '**/*.{js,mjs,json,md}' --ignore-path .gitignore",
    "audit": "pnpm audit --prod",
    "ci": "node --import ./scripts/alias-hook.mjs scripts/ci/run-tests/index.mjs all",
    "prebuild": "node --import ./scripts/alias-hook.mjs ./scripts/build/embed-skills/index.mjs && node --import ./scripts/alias-hook.mjs scripts/reports/census/index.mjs",
    "build": "bash ./scripts/package.sh",
    "prepublishOnly": "node --import ./scripts/alias-hook.mjs ./scripts/build/embed-skills/index.mjs",
    "checksums": "node --import ./scripts/alias-hook.mjs scripts/build/checksums/index.mjs",
    "audit:gate": "node --import ./scripts/alias-hook.mjs scripts/ci/audit-gate/index.mjs",
    "changelog": "node --import ./scripts/alias-hook.mjs scripts/build/changelog/index.mjs --apply",
    "cache:report": "node --import ./scripts/alias-hook.mjs scripts/reports/cache/index.mjs",
    "report:compression": "node --import ./scripts/alias-hook.mjs scripts/reports/compression/index.mjs",
    "report:startup": "node --import ./scripts/alias-hook.mjs scripts/reports/startup/index.mjs",
    "cache:similarity": "node --import ./scripts/alias-hook.mjs scripts/reports/cache-similarity/index.mjs",
    "report:decision-cache": "node --import ./scripts/alias-hook.mjs scripts/reports/decision-cache/index.mjs",
    "audit:decision-cache": "node --import ./scripts/alias-hook.mjs scripts/audits/decision-cache/corpus.mjs",
    "clean:prose": "node --import ./scripts/alias-hook.mjs scripts/fix/prose/index.mjs --apply",
    "surface:report": "node --import ./scripts/alias-hook.mjs scripts/reports/tool-surface/index.mjs",
    "wcag:update": "node --import ./scripts/alias-hook.mjs scripts/data/wcag/index.mjs --apply",
    "census": "node --import ./scripts/alias-hook.mjs scripts/reports/census/index.mjs",
    "census:check": "node --import ./scripts/alias-hook.mjs scripts/reports/census/index.mjs --check",
    "release": "node scripts/release/index.mjs"
  },
  "files": [
    "bin/",
    "packages/mcp/",
    "!packages/mcp/**/__tests__/",
    "packages/shared/",
    "!packages/shared/**/__tests__/",
    "skills/",
    "personas/",
    "prompts/",
    "scripts/",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "keywords": [
    "mcp",
    "styleguide",
    "design-system",
    "frontend",
    "react",
    "vue",
    "svelte",
    "angular",
    "solidjs",
    "astro",
    "rule-mcp",
    "desktop",
    "electron",
    "library",
    "web"
  ],
  "dependencies": {
    "rule-mcp": "workspace:0.1.2",
    "rule-mcp-shared": "workspace:0.1.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7",
    "@clack/prompts": "1.8.1",
    "@opentui/core": "0.8.2",
    "commander": "15.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/inspector": "2.14.0",
    "@playwright/test": "1.65.0",
    "c8": "12.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-unicorn": "79.0.0",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "marked": "18.1.3",
    "prettier": "3.9.10"
  }
}
