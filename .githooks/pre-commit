#!/bin/sh
# Regenerate the census and stage what it owns, so every commit ships the docs
# that match the code. The generator formats its own output, writes only the
# files that actually changed, and prints them; a changed surface therefore
# lands in the commit instead of a stale doc. Exits 0 even when nothing changed.
#
# A commit is not the place to fail over a missing dev dependency, so this
# stops early when prettier is not installed.
set -e
cd "$(git rev-parse --show-toplevel)" || exit 1

[ -d node_modules/prettier ] || exit 0

node scripts/reports/census/index.mjs >/dev/null

git add docs/02-product-architecture.md docs/05-env-variables.md docs/07-engineering-guides.md \
  docs/08-skills.md docs/09-tools.md docs/10-prompts.md docs/11-instructions.md \
  docs/12-cli.md docs/13-personas.md docs/14-guardrails.md docs/15-resources.md

exit 0
