#!/bin/sh
# rule-mcp: enforce type(scope): subject.
#
# The rule lives in src/core/commit - this hook only wires it to git, so the
# hook, the pre-push gate, the CLI and CI cannot drift apart.
#
#   format:   type(scope): subject
#   example:  feat(skills): add rule-mcp naming
#   rejected: docs: port documentation
#
# Install: pnpm hooks:install
set -e
cd "$(git rev-parse --show-toplevel)" || exit 1

msg_file="$1"
first="$(sed -n '1p' "$msg_file" 2>/dev/null)"

# System-generated messages (merge / revert) cannot carry a scope.
case "$first" in
  "Merge "*|"Revert "*) exit 0 ;;
esac

node scripts/build/commit-types/index.mjs --msg-file "$msg_file" || exit 1
exit 0
