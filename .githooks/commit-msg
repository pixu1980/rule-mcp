#!/bin/sh
# rule-mcp:commit-lint - reject a commit or push that is not type(scope): subject.
dir="$(dirname "$0")"
backup="$dir/commit-msg.rule-backup"
if command -v rule-mcp >/dev/null 2>&1; then
  rule-mcp commit-lint --msg-file "$1" || exit 1
else
  echo "rule-mcp:commit-lint: rule-mcp is not on PATH; commit validation skipped" >&2
fi
if [ -x "$backup" ]; then
  exec "$backup" "$@"
fi
exit 0
