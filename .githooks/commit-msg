#!/bin/sh
# rule-mcp: enforce conventional commits WITH scope on every commit.
#   format:   type(scope): subject
#   example:  feat(skills): add rule naming
#   rejected: docs: port documentation
#
# Install: cp .githooks/commit-msg .git/hooks/commit-msg && chmod +x .git/hooks/commit-msg

msg_file="$1"
first="$(sed -n '1p' "$msg_file" 2>/dev/null)"

# System-generated messages (merge / revert) cannot carry a scope.
case "$first" in
  "Merge "*|"Revert "*) exit 0 ;;
esac

if ! printf '%s\n' "$first" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)\([a-z0-9._-]+\): .+$'; then
  echo "commit-msg: rejected - conventional commit WITH scope required" >&2
  echo "  format:   type(scope): subject" >&2
  echo "  example:  feat(skills): add rule naming" >&2
  echo "  got:      $first" >&2
  exit 1
fi

# DCO sign-off (OSS-10): every human commit certifies the Developer
# Certificate of Origin with a trailer. Merges and reverts are exempt
# above, like for the scope check.
if ! grep -Eq '^Signed-off-by: .+ <[^<>]+>$' "$msg_file"; then
  echo "commit-msg: rejected - DCO sign-off required" >&2
  echo "  add:      Signed-off-by: Your Name <you@example.com>" >&2
  echo "  hint:     git commit -s adds it for you" >&2
  exit 1
fi
exit 0
