#!/bin/sh
# pix-galaxy-mcp:commit-lint - reject a commit or push that is not type(scope): subject.
dir="$(dirname "$0")"
backup="$dir/pre-push.pix-backup"
if command -v pix-galaxy-mcp >/dev/null 2>&1; then
  pix-galaxy-mcp commit-lint --stdin-push || exit 1
else
  echo "pix-galaxy-mcp:commit-lint: pix-galaxy-mcp is not on PATH; commit validation skipped" >&2
fi
if [ -x "$backup" ]; then
  exec "$backup" "$@"
fi
exit 0
