{
  "scopeName": "inline.rule-html-template",
  "name": "rule HTML inside js",
  "injectionSelector": "L:source.js -comment -string",
  "patterns": [
    {
      "name": "meta.template.rule.html",
      "begin": "html\\s*`",
      "beginCaptures": {
        "0": { "name": "entity.name.function.template.rule" }
      },
      "end": "`",
      "endCaptures": {
        "0": { "name": "entity.name.function.template.rule" }
      },
      "patterns": [
        { "include": "#rule-directives" },
        { "include": "#rule-expressions" },
        { "include": "#rule-events" },
        { "include": "#rule-interpolation" },
        { "include": "#html-content" }
      ]
    }
  ],
  "repository": {
    "rule-directives": {
      "patterns": [
        { "match": "<for\\b", "name": "keyword.control.rule.for" },
        { "match": "</for>", "name": "keyword.control.rule.for" },
        { "match": "<if\\b", "name": "keyword.control.rule.if" },
        { "match": "<elseif\\b", "name": "keyword.control.rule.elseif" },
        { "match": "<else>", "name": "keyword.control.rule.else" },
        { "match": "</if>", "name": "keyword.control.rule.if" },
        { "match": "<switch\\b", "name": "keyword.control.rule.switch" },
        { "match": "</switch>", "name": "keyword.control.rule.switch" },
        { "match": "<case\\b", "name": "keyword.control.rule.case" },
        { "match": "<default>", "name": "keyword.control.rule.default" },
        { "match": "\\beach\\s*=", "name": "keyword.other.rule.each" },
        { "match": "\\bcondition\\s*=", "name": "keyword.other.rule.condition" },
        { "match": "\\bexpr\\s*=", "name": "keyword.other.rule.expr" },
        { "match": "\\bresult\\s*=", "name": "keyword.other.rule.result" }
      ]
    },
    "rule-expressions": {
      "begin": "\\{\\{",
      "end": "\\}\\}",
      "name": "meta.expression.rule",
      "patterns": [
        {
          "match": "\\|\\s*(raw|upper|lower|capitalize|slugify|trim|escapeHtml|striptags|json|default|truncate|length|first|last|join|date|timeAgo|urlencode|sortBy)\\b",
          "name": "support.function.filter.rule"
        },
        { "match": "\\b(true|false|null|undefined)\\b", "name": "constant.language.rule" },
        { "match": "\\d+", "name": "constant.numeric.rule" },
        { "match": "\"[^\"]*\"|'[^']*'", "name": "string.quoted.rule" },
        { "match": "[a-zA-Z_$][\\w$.]*", "name": "variable.other.rule" }
      ]
    },
    "rule-events": {
      "match": "@[a-zA-Z]+(?:-[a-zA-Z]+)*",
      "name": "entity.other.attribute-name.event.rule"
    },
    "rule-interpolation": {
      "begin": "\\$\\{",
      "end": "\\}",
      "name": "meta.interpolation.rule",
      "patterns": [{ "include": "source.js" }]
    },
    "html-content": {
      "patterns": [{ "include": "text.html.derivative" }]
    }
  }
}
