{
  "name": "rule-vanilla-reactive",
  "displayName": "Pix Vanilla Reactive",
  "description": "Syntax highlighting and autocomplete for rule-vanilla-reactive templates (html`` and .template.html)",
  "version": "0.1.0",
  "publisher": "rule-mcp",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Language Packs"
  ],
  "keywords": [
    "rule",
    "vanilla-reactive",
    "html",
    "template",
    "web-components"
  ],
  "license": "MIT",
  "main": "./src/extension.js",
  "browser": "./src/extension.js",
  "activationEvents": [
    "onLanguage:rule-template-html",
    "onLanguage:javascript",
    "onLanguage:typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rule/rule-mcp",
    "directory": "extensions/vscode-rule"
  },
  "contributes": {
    "languages": [
      {
        "id": "rule-template-html",
        "aliases": [
          "rule HTML Template",
          "rule-template-html"
        ],
        "extensions": [
          ".template.html"
        ],
        "configuration": "./language-configuration/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "rule-template-html",
        "scopeName": "text.html.rule-template",
        "path": "./syntaxes/html-template.tmLanguage.json"
      },
      {
        "scopeName": "inline.rule-html-template",
        "path": "./syntaxes/html-in-js.tmLanguage.json",
        "injectTo": [
          "source.js",
          "source.jsx",
          "source.ts",
          "source.tsx",
          "source.mjs",
          "source.cjs"
        ],
        "embeddedLanguages": {
          "text.html.derivative": "html"
        }
      }
    ],
    "snippets": [
      {
        "language": "rule-template-html",
        "path": "./snippets/rule-template.json"
      },
      {
        "language": "javascript",
        "path": "./snippets/rule-js.json"
      }
    ]
  }
}
