# Build stage - security-focused frontend build
FROM node:24-alpine AS builder

# Run as non-root user for security
RUN addgroup -g 1001 -S buildgroup && adduser -S builduser -u 1001 -G buildgroup

WORKDIR /build

# Copy package files with correct ownership
COPY --chown=builduser:buildgroup package*.json ./

# Switch to non-root user before installing dependencies
USER builduser

# Install dependencies
RUN npm ci --only=production --ignore-scripts

# Copy application files
COPY --chown=builduser:buildgroup ./ ./

# Build the application
RUN npm run build

# The build output (typically in /build/dist or /build/build) will be copied
# to an nginx container in a separate deployment step
